APP_NAME="OSK Panel"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug
# Production deployment contract: LOG_CHANNEL=json_stderr and LOG_LEVEL=info (or stricter).

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=osk_panel
DB_USERNAME=osk_panel
DB_PASSWORD=osk_panel_local_only

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_CONNECTION=default
QUEUE_CONNECTION=redis

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=osk-panel-test
AWS_ENDPOINT=http://localhost:5000
AWS_USE_PATH_STYLE_ENDPOINT=true

UPLOAD_STORAGE_DISK=s3
UPLOAD_PRESIGN_TTL_MINUTES=15

MAIL_MAILER=log

# Internal exams: exact values are deployment security/product policy.
INTERNAL_EXAM_STATION_HEARTBEAT_FRESH_SECONDS=
INTERNAL_EXAM_EXECUTION_TOKEN_TTL_MINUTES=
INTERNAL_EXAM_RESULT_TOKEN_TTL_MINUTES=
INTERNAL_EXAM_REMOTE_ACCESS_TTL_MINUTES=
INTERNAL_EXAM_REMOTE_PUBLIC_BASE_URL=
INTERNAL_EXAM_TOKEN_VERIFIER_KEY_V1=
INTERNAL_EXAM_STATION_VERIFIER_KEY_V1=

# Sensitive identifiers (PESEL / local PKK identity).
# The lookup key MUST be independent from APP_KEY and use high-entropy secret material.
# During rollover, keep old lookup keys comma-separated until all data governed by them
# has left retention or has been re-keyed by an explicitly reviewed maintenance process.
SENSITIVE_IDENTIFIER_LOOKUP_KEY=
SENSITIVE_IDENTIFIER_PREVIOUS_LOOKUP_KEYS=
APP_PREVIOUS_KEYS=

# Incident response contact references.
# Keep real contact addresses/phone numbers/paging tokens out of the repository.
# Production deployment must inject resolvable references and pass a paging smoke test.
INCIDENT_PRIMARY_ON_CALL_REF=
INCIDENT_TECHNICAL_LEAD_REF=
INCIDENT_PRIVACY_LEAD_REF=
INCIDENT_BUSINESS_LIAISON_REF=
INCIDENT_COMMUNICATIONS_LEAD_REF=
INCIDENT_PAGING_CHANNEL_REF=

# Optional social sign-in/linking provider registry.
# Inject deployment credentials outside the repository. Value is a JSON object keyed by provider code.
# Each enabled provider supplies authorization_url, token_url, userinfo_url, redirect_uri,
# client_id, client_secret and scopes. Production endpoints must use HTTPS.
SOCIAL_OAUTH_PROVIDERS_JSON=[]

# Self-service password recovery.
# Reset URL must contain the literal {token} placeholder. Production must use HTTPS.
PASSWORD_RESET_URL_TEMPLATE=
# Optional explicit synchronous mailer. Log transport is rejected for reset-token delivery.
PASSWORD_RESET_MAILER=

# Privileged retention executor is intentionally disabled by default.
RETENTION_EXECUTOR_ENABLED=false
RETENTION_EXECUTOR_MAX_ROWS=1000

# Provider-neutral operational alert delivery.
# Disabled by default outside the production target. Production preflight requires
# enablement, an HTTPS destination and an injected HMAC secret.
OPS_ALERTING_ENABLED=false
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_WEBHOOK_SECRET=
OPS_ALERT_TIMEOUT_SECONDS=5


# Development/demo bootstrap only.
# Enables the clearly labeled sample terms document and sample license catalog/pricing.
# config/sample_data.php fails closed if this is enabled with APP_ENV=production.
SAMPLE_DATA_ENABLED=true

# Real deployment pricing overrides sample pricing entirely.
# JSON object keyed by commerce_catalog_items.code.
COMMERCE_ORDER_CREATE_PRICING_JSON=
COMMERCE_ORDER_CREATE_INTERNAL_EXAM_CATALOG_CODE=
