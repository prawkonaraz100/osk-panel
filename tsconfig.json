{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "allowJs": false,
    "isolatedModules": true
  },
  "include": ["resources/js/**/*.ts", "resources/js/**/*.vue", "vite.config.ts"]
}
